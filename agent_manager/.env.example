# Copy this file to .env and fill in your API keys.
# You only need keys for the providers you want to use.

# Groq — free tier at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — free tier at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — free models at https://openrouter.ai
OPENROUTER_API_KEY=

# Ollama — runs locally, no key needed. Set model name if not using llama3.2
OLLAMA_MODEL=llama3.2
